
/* =================================
   SAKUHEMAT - FORGOT PASSWORD
================================= */

:root {
    --cream: #f5f3ec;
    --yellow: #FFE600;
    --red: #ed1745;
    --cyan: #00c9ee;
    --mint: #55c9a0;
    --dark: #111713;
    --white: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;

    padding: 35px 20px;

    overflow-x: hidden;

    background: var(--cream);
    color: var(--dark);

    font-family: 'Plus Jakarta Sans', sans-serif;
}

/* BACKGROUND DECORATION */

.background-shape {
    position: fixed;
    z-index: -1;

    border-radius: 50%;
    filter: blur(2px);

    pointer-events: none;
}

.shape-one {
    width: 400px;
    height: 400px;

    top: -160px;
    left: -130px;

    background: radial-gradient(
        circle,
        rgba(85, 201, 160, 0.35),
        transparent 70%
    );
}

.shape-two {
    width: 450px;
    height: 450px;

    right: -170px;
    bottom: -190px;

    background: radial-gradient(
        circle,
        rgba(0, 201, 238, 0.2),
        transparent 70%
    );
}

/* MAIN WRAPPER */

.reset-wrapper {
    width: 100%;
    max-width: 480px;

    animation: appear 0.7s ease both;
}

/* CARD */

.reset-card {
    position: relative;

    width: 100%;

    padding: 32px;

    overflow: hidden;

    border: 2px solid var(--dark);
    border-radius: 28px;

    background: var(--white);

    box-shadow: 8px 8px 0 var(--dark);
}

/* BACK BUTTON */

.back-link {
    display: inline-block;

    margin-bottom: 28px;

    color: #555;
    font-size: 12px;
    font-weight: 700;

    text-decoration: none;
    transition: 0.25s ease;
}

.back-link:hover {
    color: var(--red);
    transform: translateX(-4px);
}

/* BRAND */

.reset-brand {
    display: flex;
    align-items: center;
    gap: 10px;

    font-size: 16px;
    font-weight: 800;
}

.brand-icon {
    width: 37px;
    height: 37px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 2px solid var(--dark);
    border-radius: 12px;

    background: var(--cyan);

    color: white;

    font-family: 'Archivo Black', sans-serif;
    font-size: 23px;

    box-shadow: 3px 3px 0 var(--dark);
}

.reset-brand > span > span {
    color: var(--red);
}

/* ILLUSTRATION */

.reset-illustration {
    position: relative;

    display: flex;
    justify-content: center;
    align-items: center;

    height: 145px;

    margin: 18px 0 10px;
}

.illustration-circle {
    width: 105px;
    height: 105px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 2px solid var(--dark);
    border-radius: 32px;

    background: linear-gradient(
        135deg,
        #c8f4df,
        #75d8b1
    );

    box-shadow: 5px 5px 0 var(--dark);

    transform: rotate(-8deg);

    animation: floatLock 3s ease-in-out infinite;
}

.lock-icon {
    font-size: 48px;
}

.spark {
    position: absolute;

    font-size: 25px;
    font-weight: 800;

    animation: sparkle 2s ease-in-out infinite;
}

.spark-one {
    top: 10px;
    right: 27%;
    color: var(--red);
}

.spark-two {
    bottom: 12px;
    left: 25%;
    color: var(--cyan);
    animation-delay: 0.5s;
}

.spark-three {
    top: 30px;
    left: 27%;
    color: #d5a900;
    animation-delay: 1s;
}

/* HEADING */

.reset-heading {
    margin-bottom: 25px;
}

.eyebrow {
    display: inline-block;

    margin-bottom: 10px;

    color: #739487;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 3px;
}

.reset-heading h1 {
    font-family: 'Archivo Black', sans-serif;

    font-size: clamp(35px, 8vw, 45px);
    line-height: 1.08;
    letter-spacing: -2px;
}

.reset-heading h1 span {
    color: var(--red);
}

.reset-heading p {
    max-width: 350px;

    margin-top: 13px;

    color: #737b75;

    font-size: 12px;
    line-height: 1.8;
}

/* FORM */

.reset-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.reset-form label {
    margin-top: 8px;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

.input-box {
    display: flex;
    align-items: center;
    gap: 12px;

    width: 100%;
    min-height: 52px;

    padding: 0 15px;

    border: 1.5px solid #d7ded8;
    border-radius: 13px;

    background: #f8faf7;

    transition: 0.25s ease;
}

.input-box:focus-within {
    border-color: var(--mint);

    box-shadow: 0 0 0 4px rgba(85, 201, 160, 0.15);

    background: white;
}

.input-box > span {
    font-size: 17px;
}

.input-box input {
    width: 100%;

    border: none;
    outline: none;

    background: transparent;

    color: var(--dark);

    font-family: inherit;
    font-size: 12px;
}

.input-box input::placeholder {
    color: #a5aca6;
}

/* NOTE */

.reset-note {
    margin-top: 5px;

    color: #929991;

    font-size: 10px;
    line-height: 1.6;
}

/* BUTTON */

#tombolReset {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
    min-height: 52px;

    margin-top: 12px;
    padding: 0 18px;

    border: 2px solid var(--dark);
    border-radius: 13px;

    background: var(--yellow);
    color: var(--dark);

    font-family: inherit;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;

    cursor: pointer;

    box-shadow: 4px 4px 0 var(--dark);

    transition: 0.2s ease;
}

#tombolReset:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--dark);
    background: #f4d900;
}

#tombolReset span {
    font-size: 19px;
}

/* FOOTER */

.reset-footer {
    margin-top: 30px;

    color: #a1b5a9;

    font-size: 9px;
    font-weight: 800;
    letter-spacing: 2px;
    text-align: center;
}

/* POPUP */

.popup-overlay {
    position: fixed;
    inset: 0;

    z-index: 1000;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(10, 20, 15, 0.55);
    backdrop-filter: blur(7px);

    opacity: 0;
    visibility: hidden;

    transition: 0.3s ease;
}

.popup-overlay.active {
    opacity: 1;
    visibility: visible;
}

.popup-card {
    width: 100%;
    max-width: 350px;

    padding: 30px 25px;

    border: 2px solid var(--dark);
    border-radius: 22px;

    background: var(--cream);

    box-shadow: 6px 6px 0 var(--dark);

    text-align: center;

    transform: translateY(20px) scale(0.95);
    transition: 0.3s ease;
}

.popup-overlay.active .popup-card {
    transform: translateY(0) scale(1);
}

.popup-icon {
    margin-bottom: 12px;
    font-size: 40px;
}

.popup-card h2 {
    margin-bottom: 10px;

    font-family: 'Archivo Black', sans-serif;
    font-size: 20px;
}

.popup-card p {
    color: #68736c;
    font-size: 12px;
    line-height: 1.7;
}

#popupButton {
    width: 100%;

    margin-top: 22px;
    padding: 13px;

    border: 2px solid var(--dark);
    border-radius: 11px;

    background: var(--yellow);

    font-family: inherit;
    font-size: 11px;
    font-weight: 800;

    cursor: pointer;
}

/* ANIMATIONS */

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes floatLock {
    0%, 100% {
        transform: translateY(0) rotate(-8deg);
    }

    50% {
        transform: translateY(-8px) rotate(5deg);
    }
}

@keyframes sparkle {
    0%, 100% {
        opacity: 0.5;
        transform: scale(0.8) rotate(0deg);
    }

    50% {
        opacity: 1;
        transform: scale(1.2) rotate(20deg);
    }
}

/* MOBILE */

@media (max-width: 480px) {
    body {
        padding: 20px 15px;
    }

    .reset-card {
        padding: 25px 21px;
        border-radius: 23px;
    }

    .reset-heading h1 {
        font-size: 37px;
    }
}

/* REDUCE MOTION */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
